# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# Postgres connection string (Neon pooled URL recommended). Required as of Phase 3.
RAG_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# JWT signing secret. Leave unset for local dev (an ephemeral one is generated with
# a warning); set a real random value before deploying, or every restart invalidates
# all logged-in sessions.
RAG_JWT_SECRET=

# Hosted LLM inference, Groq primary / Gemini fallback. Required as of Phase 4 —
# no self-hosted Ollama anymore. Get free keys at console.groq.com and
# aistudio.google.com.
RAG_GROQ_API_KEY=
RAG_GEMINI_API_KEY=
